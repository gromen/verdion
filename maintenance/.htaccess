Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to index.html and static assets
    RewriteCond %{REQUEST_URI} ^/index\.html$ [OR]
    RewriteCond %{REQUEST_URI} \.(css|js|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf|otf)$
    RewriteRule ^ - [L]

    # Return 503 for everything else
    RewriteRule ^ /index.html [R=503,L]
</IfModule>

# 503 response
<IfModule mod_headers.c>
    Header always set Retry-After "86400"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
    Header always set Pragma "no-cache"

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ErrorDocument to render index.html for 503
ErrorDocument 503 /index.html
